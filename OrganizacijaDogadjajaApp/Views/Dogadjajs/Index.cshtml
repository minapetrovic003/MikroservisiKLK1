@model IEnumerable<OrganizacijaDogadjajaApp.DTO.DogadjajDTO>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

@if (ViewBag.ExceptionMessage != null)
{
    <div class="alert alert-danger">
        @ViewBag.ExceptionMessage
    </div>
}

<p>
    <a asp-action="Create">Create New</a>
</p>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-warning">
        Nema učitanih događaja.
    </div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.NazivDogadjaja)
                </th>

                <th>
                    @Html.DisplayNameFor(model => model.AgendaDogadjaja)
                </th>

                <th>
                    @Html.DisplayNameFor(model => model.DatumIVreme)
                </th>

                <th>
                    @Html.DisplayNameFor(model => model.Trajanje)
                </th>

                <th>
                    @Html.DisplayNameFor(model => model.CenaKotizacije)
                </th>

                <th>
                    Lokacija
                </th>

                <th>
                    Tip događaja
                </th>

                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @item.NazivDogadjaja
                    </td>

                    <td>
                        @item.AgendaDogadjaja
                    </td>

                    <td>
                        @item.DatumIVreme
                    </td>

                    <td>
                        @item.Trajanje
                    </td>

                    <td>
                        @item.CenaKotizacije
                    </td>

                    <td>
                        @item.NazivLokacije
                    </td>

                    <td>
                        @item.NazivTipaDogadjaja
                    </td>

                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}